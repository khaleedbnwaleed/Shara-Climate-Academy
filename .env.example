# SCORM Cloud > Apps / API > application credentials (server-side only)
SCORM_CLOUD_APP_ID=
SCORM_CLOUD_SECRET_KEY=

# Base64-encoded Firebase Admin service-account JSON (server-side only).
# Never prefix these secrets with NEXT_PUBLIC_.
FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64=

# Optional comma-separated allowlist of HTTPS hostnames for remotely hosted
# package ZIPs, for example packages.example.org,cdn.example.org.
SCORM_ALLOWED_PACKAGE_HOSTS=
