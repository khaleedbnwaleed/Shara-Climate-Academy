# Copy to .env.local and fill in real values. .env.local is git-ignored.
# NEVER prefix server secrets with NEXT_PUBLIC_ and never use .env.production
# (that file is tracked in git).

# --- Firebase (client, public by design — mirrors lib/firebase.ts) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shara-climate-ad59c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shara-climate-ad59c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shara-climate-ad59c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=577674492589
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Payments (server-side) ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Course image uploads (server-side) ---
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPO=
GITHUB_BRANCH=main

# --- N-ATLAS AI Climate Tutor (server-side; see docs/natlas-team-handover.md) ---
# After `modal deploy serve/modal_app.py`, paste YOUR gateway URL here:
NATLAS_BASE_URL=
# The key you generated with `openssl rand -hex 32` (same value as the Modal
# secret natlas-api / NATLAS_API_KEYS):
NATLAS_API_KEY=
NATLAS_MODEL=NCAIR1/N-ATLaS
SHARA_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Optional hardening ---
# Service-account JSON on one line: enables Firestore-backed shared rate
# limiting across serverless instances (recommended in production):
FIREBASE_SERVICE_ACCOUNT=
# Tutor rate limit tuning (defaults 20 requests / 10 minutes per learner):
NATLAS_RATE_LIMIT_MAX=
NATLAS_RATE_LIMIT_WINDOW_MINUTES=
